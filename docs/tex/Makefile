# Builds the LaTeX guides.
#
#   make            all PDFs
#   make user       docs/tex/user_guide/calango_user_guide.pdf
#   make packaging  docs/tex/packaging/packaging.pdf
#   make dft        docs/tex/dft/calango_dft.pdf
#   make clean      remove the LaTeX aux files (keeps the PDFs)
#
# Before each build the project version is read out of CMakeLists.txt and
# written to calango_version.tex next to each source, so the covers cannot
# drift from the binary. Both sources fall back to a literal version when
# that file is absent, so plain `pdflatex` in either directory still works.

TEXDIR   := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))
ROOT     := $(abspath $(TEXDIR)../..)
VERSION  := $(shell sed -n 's/^[[:space:]]*VERSION[[:space:]]\{1,\}\([0-9.]\{1,\}\).*/\1/p' $(ROOT)/CMakeLists.txt | head -1)

LATEXMK  := latexmk -pdf -interaction=nonstopmode -halt-on-error

.PHONY: all user packaging dft clean

all: user packaging dft

user:
	@printf '%% Generated by docs/tex/Makefile -- do not edit.\n\\newcommand{\\calangoversion}{$(VERSION)}\n' \
	    > $(TEXDIR)user_guide/calango_version.tex
	cd $(TEXDIR)user_guide && $(LATEXMK) calango_user_guide.tex

dft:
	@printf '%% Generated by docs/tex/Makefile -- do not edit.\n\\newcommand{\\calangoversion}{$(VERSION)}\n' \
	    > $(TEXDIR)dft/calango_version.tex
	cd $(TEXDIR)dft && $(LATEXMK) calango_dft.tex

packaging:
	@printf '%% Generated by docs/tex/Makefile -- do not edit.\n\\newcommand{\\calangoversion}{$(VERSION)}\n' \
	    > $(TEXDIR)packaging/calango_version.tex
	cd $(TEXDIR)packaging && $(LATEXMK) packaging.tex

clean:
	cd $(TEXDIR)user_guide && latexmk -c calango_user_guide.tex
	cd $(TEXDIR)packaging  && latexmk -c packaging.tex
