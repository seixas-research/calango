<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Bundle Info.plist template, substituted by CMake (MACOSX_BUNDLE_INFO_PLIST).

     This replaces CMake's stock template for one reason: document types.
     CFBundleDocumentTypes + UTExportedTypeDeclarations are what make Finder
     offer Calango for .calproj and .extxyz double-clicks; Launch Services
     reads them from the installed bundle. The opened file reaches the app as
     an Apple Event that Qt surfaces as a QFileOpenEvent (handled in
     src/main.cpp), not as argv. -->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>English</string>
	<key>CFBundleExecutable</key>
	<string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
	<key>CFBundleGetInfoString</key>
	<string>${MACOSX_BUNDLE_INFO_STRING}</string>
	<key>CFBundleIconFile</key>
	<string>${MACOSX_BUNDLE_ICON_FILE}</string>
	<key>CFBundleIdentifier</key>
	<string>${MACOSX_BUNDLE_GUI_IDENTIFIER}</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>${MACOSX_BUNDLE_BUNDLE_NAME}</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>${MACOSX_BUNDLE_SHORT_VERSION_STRING}</string>
	<key>CFBundleVersion</key>
	<string>${MACOSX_BUNDLE_BUNDLE_VERSION}</string>
	<key>NSHumanReadableCopyright</key>
	<string>${MACOSX_BUNDLE_COPYRIGHT}</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Calango project</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleTypeIconFile</key>
			<string>${MACOSX_BUNDLE_ICON_FILE}</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.seixasresearch.calango.calproj</string>
			</array>
			<key>LSHandlerRank</key>
			<string>Owner</string>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Extended XYZ atomic structure</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleTypeIconFile</key>
			<string>${MACOSX_BUNDLE_ICON_FILE}</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.seixasresearch.calango.extxyz</string>
			</array>
			<!-- Default, not Owner: .extxyz is a community format Calango
			     reads, not a format it defines. -->
			<key>LSHandlerRank</key>
			<string>Default</string>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>org.seixasresearch.calango.calproj</string>
			<key>UTTypeDescription</key>
			<string>Calango project</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>calproj</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/x-calango-project</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>org.seixasresearch.calango.extxyz</string>
			<key>UTTypeDescription</key>
			<string>Extended XYZ atomic structure</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.plain-text</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>extxyz</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/x-extxyz</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
